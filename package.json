		"lint": "eslint . --max-warnings 0"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@eslint/json": "0.14.0",
		"@types/node": "^22.15.17",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.13.0",
		"jiti": "^2.6.1",
		"obsidian": "~1.13.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1"
	},
	"allowScripts": {
		"esbuild@0.28.2": true
	}
