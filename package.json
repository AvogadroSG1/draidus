{
	"name": "draidus",
	"version": "1.0.0",
	"description": "Turn notes into actions on external services.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
